# NAC Platform — 개발 환경 변수
# 이 파일을 .env 로 복사 후 편집: cp .env.example .env

# ── 데이터베이스 ──────────────────────────────────────────────────────────
DATABASE_URL=postgres://nac:nac_dev_password@localhost:5432/nac

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── NATS ──────────────────────────────────────────────────────────────────
NATS_URL=nats://localhost:4222

# ── 서비스별 바인드 주소 ──────────────────────────────────────────────────
# policy-manager
LISTEN_ADDR=0.0.0.0:8001

# api-gateway
# LISTEN_ADDR=0.0.0.0:8000

# ── API Gateway ───────────────────────────────────────────────────────────
POLICY_MANAGER_URL=http://localhost:8001
ADMIN_USER=admin
ADMIN_PASS=changeme

# ── 인증 / JWT ────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-at-least-32-chars!!

# ── LDAP (AD/LDAP 연동 — 미설정시 mock 모드) ─────────────────────────────
# LDAP_URL=ldap://localhost:389
# LDAP_BIND_DN=cn=admin,dc=corp,dc=local
# LDAP_BIND_PW=admin_password
# LDAP_USER_BASE=ou=users,dc=corp,dc=local
# LDAP_USER_FILTER=(&(objectClass=person)(uid={}))

# ── Captive Portal ────────────────────────────────────────────────────────
CAPTIVE_PORTAL_ADDR=0.0.0.0:8080

# ── RADIUS ───────────────────────────────────────────────────────────────
RADIUS_SECRET=radius-shared-secret
RADIUS_AUTH_ADDR=0.0.0.0:1812
RADIUS_ACCT_ADDR=0.0.0.0:1813

# ── Agent Gateway (gRPC) ─────────────────────────────────────────────────
GRPC_ADDR=0.0.0.0:50051

# ── Endpoint Agent ────────────────────────────────────────────────────────
AGENT_GATEWAY_ADDR=http://localhost:50051
CHECKIN_INTERVAL_SECS=60
DEVICE_ID_FILE=/var/lib/nac-agent/device-id

# ── DHCP 서버 ─────────────────────────────────────────────────────────────
DHCP_BIND_ADDR=0.0.0.0:67
DHCP_POOL_START=192.168.1.100
DHCP_POOL_END=192.168.1.200
DHCP_SUBNET_MASK=255.255.255.0
DHCP_GATEWAY=192.168.1.1
DHCP_SERVER_IP=192.168.1.1

# ── 로깅 ─────────────────────────────────────────────────────────────────
RUST_LOG=info
# RUST_LOG=debug,sqlx=warn,hyper=warn,tonic=warn

# ── TLS (프로덕션 — 리버스 프록시 또는 cert-manager 권장) ────────────────
# TLS_CERT_PATH=/etc/nac/certs/server.pem
# TLS_KEY_PATH=/etc/nac/certs/server.key
# CA_CERT_PATH=/etc/nac/certs/ca.pem
