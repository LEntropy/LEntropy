# NAC Platform — 개발 환경 변수
# 이 파일을 .env 로 복사 후 편집: cp .env.example .env

# ── 데이터베이스 ──────────────────────────────────────────
DATABASE_URL=postgres://nac:nac_dev_password@localhost:5432/nac

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── NATS ──────────────────────────────────────────────────
NATS_URL=nats://localhost:4222

# ── 서비스별 바인드 주소 ──────────────────────────────────
# api-gateway
LISTEN_ADDR=0.0.0.0:8080

# ── 인증 ──────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-at-least-32-chars!!

# LDAP (AD 연동 — 선택)
# LDAP_URL=ldap://192.168.1.10:389
# LDAP_BIND_DN=CN=svc-nac,OU=Service,DC=corp,DC=example,DC=com
# LDAP_BIND_PW=secret
# LDAP_BASE_DN=DC=corp,DC=example,DC=com

# ── RADIUS (Phase 4) ──────────────────────────────────────
# RADIUS_SECRET=shared-secret
# RADIUS_BIND=0.0.0.0:1812

# ── 로깅 ──────────────────────────────────────────────────
RUST_LOG=info
# RUST_LOG=debug,sqlx=warn,hyper=warn

# ── TLS (Phase 3+) ───────────────────────────────────────
# TLS_CERT_PATH=/etc/nac/certs/server.pem
# TLS_KEY_PATH=/etc/nac/certs/server.key
# CA_CERT_PATH=/etc/nac/certs/ca.pem
