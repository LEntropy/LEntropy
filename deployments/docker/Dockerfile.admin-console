# Multi-stage build for React Admin Console
FROM node:22-alpine AS builder

WORKDIR /app

COPY web/admin-console/package*.json ./
RUN npm ci

COPY web/admin-console/ .
RUN npm run build

FROM nginx:alpine AS runtime

COPY --from=builder /app/dist /usr/share/nginx/html

# SPA 라우팅을 위한 nginx 설정
RUN printf 'server {\n\
    listen 80;\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
    location /api/ {\n\
        proxy_pass http://api-gateway:8000;\n\
    }\n\
    location / {\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
