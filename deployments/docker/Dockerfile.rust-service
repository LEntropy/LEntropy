# Multi-stage build for Rust services
ARG SERVICE_NAME

FROM rust:1.87-slim AS builder
ARG SERVICE_NAME

RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Cargo 워크스페이스 메타데이터 (모든 멤버의 Cargo.toml 필요)
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates/ crates/
COPY proto/ proto/

# 워크스페이스 모든 서비스의 Cargo.toml 복사 (워크스페이스 해석에 필요)
COPY services/policy-manager/Cargo.toml  services/policy-manager/
COPY services/sensor/Cargo.toml          services/sensor/
COPY services/enforcement/Cargo.toml     services/enforcement/
COPY services/aaa/Cargo.toml             services/aaa/
COPY services/dhcp/Cargo.toml            services/dhcp/
COPY services/agent-gateway/Cargo.toml   services/agent-gateway/
COPY services/api-gateway/Cargo.toml     services/api-gateway/
COPY services/endpoint-agent/Cargo.toml  services/endpoint-agent/
COPY test/integration/Cargo.toml         test/integration/

# sqlx::migrate! 매크로는 컴파일 타임에 migrations 디렉토리를 읽음
COPY services/policy-manager/migrations/ services/policy-manager/migrations/

# 더미 main으로 의존성만 빌드 (캐시 최적화)
RUN for svc in policy-manager sensor enforcement aaa dhcp agent-gateway api-gateway endpoint-agent; do \
        mkdir -p services/$svc/src && \
        echo 'fn main() {}' > services/$svc/src/main.rs; \
    done && \
    mkdir -p test/integration/src && \
    echo 'fn main() {}' > test/integration/src/main.rs && \
    cargo build --release -p ${SERVICE_NAME} 2>/dev/null || true

# 실제 소스 복사 및 빌드
COPY services/${SERVICE_NAME}/src/ services/${SERVICE_NAME}/src/
RUN touch services/${SERVICE_NAME}/src/main.rs && \
    cargo build --release -p ${SERVICE_NAME}

FROM debian:bookworm-slim AS runtime
ARG SERVICE_NAME

RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -r -s /bin/false nac
USER nac

COPY --from=builder /build/target/release/${SERVICE_NAME} /usr/local/bin/service

ENTRYPOINT ["/usr/local/bin/service"]
